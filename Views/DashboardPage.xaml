<Page x:Class="VicarShotgunKeyboard.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B0B0E"><ScrollViewer Padding="28"><StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Center"><Grid><StackPanel><TextBlock Text="Dashboard" FontSize="34" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Local keyboard sound effects. No typing data is captured." Foreground="#9696A3"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="StatusDot" Text="●" FontSize="20" Foreground="#E53935"/><TextBlock x:Name="StatusText" Text="ACTIVE" Foreground="White" Margin="8,0,0,0"/></StackPanel></Grid><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="SHOTGUN MODE" Foreground="#8F8F9A"/><ToggleSwitch x:Name="ModeSwitch" Toggled="ModeSwitch_Toggled" IsOn="True"/><TextBlock x:Name="ModeText" Text="ON" FontSize="40" FontWeight="Bold" Foreground="White"/></StackPanel></Border><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Volume" FontSize="20" Foreground="White"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="Volume_ValueChanged"/><TextBlock x:Name="VolumeLabel" Foreground="#BEBEC7"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Sound Pack" FontSize="20" Foreground="White"/><ComboBox x:Name="PackCombo" SelectionChanged="Pack_Changed"/><TextBlock Text="Sound" Foreground="#9696A3"/><ComboBox x:Name="SoundCombo" SelectionChanged="Sound_Changed"/><Button Content="TEST SOUND" Click="Test_Click" Style="{StaticResource AccentButtonStyle}"/></StackPanel></Border></Grid><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Keyboard Preview" FontSize="20" Foreground="White"/><TextBlock Text="Live feedback only — no typed text is displayed." Foreground="#70707A"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="KeyboardPreview" Orientation="Horizontal" HorizontalAlignment="Center"/></ScrollViewer></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="Privacy" FontSize="20" Foreground="White"/><TextBlock Text="Your keystrokes are never recorded, stored, or transmitted. Keyboard input is used only to trigger sound effects locally." TextWrapping="Wrap" Foreground="#A7A7B2"/><CheckBox x:Name="RandomBox" Content="Randomize sounds" IsChecked="True" Checked="Random_Changed" Unchecked="Random_Changed"/><CheckBox x:Name="OverlapBox" Content="Allow overlapping sounds" IsChecked="True" Checked="Overlap_Changed" Unchecked="Overlap_Changed"/><TextBlock Text="Maximum simultaneous sounds" Foreground="#9696A3"/><Slider x:Name="MaxVoices" Minimum="1" Maximum="20" Value="8" ValueChanged="Max_Changed"/></StackPanel></Border></StackPanel></ScrollViewer></Page>