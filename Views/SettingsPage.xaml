<Page x:Class="VicarShotgunKeyboard.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B0B0E"><ScrollViewer Padding="28"><StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Center"><TextBlock Text="Settings" FontSize="34" Foreground="White" FontWeight="SemiBold"/><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Keyboard" FontSize="22" Foreground="White"/><CheckBox x:Name="RepeatBox" Content="Ignore key repeat" IsChecked="True" Click="Changed"/><CheckBox x:Name="ReleaseBox" Content="Trigger on key release" Click="Changed"/><CheckBox x:Name="LettersBox" Content="Letters" IsChecked="True" Click="Changed"/><CheckBox x:Name="NumbersBox" Content="Numbers" IsChecked="True" Click="Changed"/><CheckBox x:Name="SymbolsBox" Content="Symbols" IsChecked="True" Click="Changed"/><CheckBox x:Name="SpaceBox" Content="Space" IsChecked="True" Click="Changed"/><CheckBox x:Name="EnterBox" Content="Enter" IsChecked="True" Click="Changed"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="General" FontSize="22" Foreground="White"/><CheckBox x:Name="TrayBox" Content="Minimize to tray" IsChecked="True" Click="Changed"/><TextBlock Text="Global hotkey: Ctrl + Shift + S" Foreground="#A7A7B2"/><TextBlock Text="Startup and tray integrations are designed to require no administrator privileges." Foreground="#777784" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="Privacy" FontSize="22" Foreground="White"/><TextBlock Text="Your keystrokes are never recorded, stored, or transmitted. Keyboard input is used only to trigger sound effects locally." Foreground="#A7A7B2" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></Page>